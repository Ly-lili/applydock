{
  "name": "job-application-panel",
  "version": "0.1.0",
  "private": true,
  "description": "求职投递悬浮面板",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && pnpm build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p electron/tsconfig.json && node scripts/copy-wasm.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "build": "pnpm typecheck && vite build && pnpm build:main",
    "dist:win": "pnpm build && electron-builder --win dir",
    "start": "electron ."
  },
  "build": {
    "appId": "com.local.jobapplicationpanel",
    "productName": "投递助手",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/sql-wasm.wasm"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.4.0"
  }
}
